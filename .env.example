# Copy to `.env` for local development:  cp .env.example .env
#
# All settings are optional — the defaults below are the local-development
# defaults baked into `portfolio_rag.core.config`.
# NEVER put real secrets in this file. It is committed to git.

# Deployment environment: local | staging | production
PORTFOLIO_RAG_ENVIRONMENT=local

# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
PORTFOLIO_RAG_LOG_LEVEL=INFO

# Comma-separated list of browser origins allowed to call the API (CORS).
# The wildcard "*" is rejected in every environment — list concrete origins.
PORTFOLIO_RAG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Emit logs as JSON lines instead of human-readable text.
# Defaults to true outside of `local`.
# PORTFOLIO_RAG_JSON_LOGS=false

# --- Knowledge --------------------------------------------------------------
# Where the corpus is read from — by the CLI, and at startup, so a retrieved
# passage can be resolved back to its text.
# PORTFOLIO_RAG_KNOWLEDGE_ROOT=knowledge

# --- Providers and stores ---------------------------------------------------
# The defaults are offline: the deterministic embedding provider, the
# deterministic generation stub and the in-memory vector store need no account,
# no key and no network. Indexing, retrieval and `POST /api/v1/chat` all work
# with every value below unset.
#
# Both `deterministic` adapters are development stand-ins and are refused when
# PORTFOLIO_RAG_ENVIRONMENT=production: the embedding one produces vectors with
# no meaning, and the generation one produces no language at all. A production
# run has to name real providers, or it will not start.

# deterministic | mistral
# PORTFOLIO_RAG_EMBEDDING_PROVIDER=deterministic

# deterministic | mistral | cloudflare_workers_ai
# PORTFOLIO_RAG_LLM_PROVIDER=deterministic

# memory | vectorize
# PORTFOLIO_RAG_VECTOR_STORE=memory

# Seconds before an outbound provider or store request is abandoned.
# PORTFOLIO_RAG_PROVIDER_TIMEOUT_SECONDS=30
# End-to-end limit for one chat request; provisional, not measured.
# PORTFOLIO_RAG_REQUEST_DEADLINE_SECONDS=60

# One key, two models. Embedding and generation are configured separately on
# purpose — sending a prompt to an embedding model fails a long way from the
# mistake.
# PORTFOLIO_RAG_MISTRAL_API_KEY=
# PORTFOLIO_RAG_MISTRAL_EMBEDDING_MODEL=mistral-embed
# PORTFOLIO_RAG_MISTRAL_CHAT_MODEL=mistral-small-latest

# One account, two products, two tokens. The account id is shared; the tokens
# are not, so a token scoped to Vectorize cannot spend Workers AI and vice
# versa. Nothing here provisions cloud resources — the index must already exist.
# PORTFOLIO_RAG_CLOUDFLARE_ACCOUNT_ID=

# Only needed for PORTFOLIO_RAG_VECTOR_STORE=vectorize.
# PORTFOLIO_RAG_CLOUDFLARE_API_TOKEN=
# PORTFOLIO_RAG_CLOUDFLARE_VECTORIZE_INDEX=

# Only needed for PORTFOLIO_RAG_LLM_PROVIDER=cloudflare_workers_ai.
# PORTFOLIO_RAG_CLOUDFLARE_WORKERS_AI_TOKEN=
# PORTFOLIO_RAG_CLOUDFLARE_WORKERS_AI_CHAT_MODEL=@cf/openai/gpt-oss-120b

# --- The edge boundary ------------------------------------------------------
# The expensive route refuses requests that did not come through the gateway
# (see docs/DEPLOYMENT.md and edge/). The gateway sets a header; this service
# compares it. NEVER put the real value here — this file is committed.
#
# On by default when PORTFOLIO_RAG_ENVIRONMENT=production, off everywhere else.
# Set REQUIRE_EDGE_AUTH explicitly to check the guard locally, or to run
# somewhere the gateway genuinely is not in front. A production app that turns
# the guard on without a secret refuses to start.
# PORTFOLIO_RAG_EDGE_SHARED_SECRET=replace-me-with-a-long-random-value
# PORTFOLIO_RAG_REQUIRE_EDGE_AUTH=false

# --- Retrieval tuning -------------------------------------------------------
# Overrides. Unset means "whatever `portfolio_rag.rag.policy` says", which is
# where the defaults live so that no second copy of them can drift.
#
# Both carry the values production runs at — top k 5, min similarity 0.250 —
# evaluated against the real corpus on the production retrieval path
# (`mistral-embed` into Cloudflare Vectorize). That makes them a measured
# baseline, not universally optimal values: re-evaluate if the corpus, the
# embedding model or the chunking policy changes. `MIN_SIMILARITY` is a cosine
# similarity — it orders results, it is not a confidence.
#
# Worth knowing locally: the deterministic embedding provider has no semantics,
# so every score it produces is noise around zero and nothing clears the default
# threshold. Set it to -1 to see results with the offline stack.
# PORTFOLIO_RAG_RETRIEVAL_TOP_K=5
# PORTFOLIO_RAG_RETRIEVAL_MIN_SIMILARITY=0.25

# --- Opt-in live tests ------------------------------------------------------
# Standard tests and CI never touch an external service. Setting these makes the
# tests in `tests/live/` run against real accounts, which costs money and writes
# to a real index. Use a dedicated test index, never the production one.
# PORTFOLIO_RAG_LIVE_TESTS=1
# PORTFOLIO_RAG_VECTORIZE_TEST_INDEX=
# The Workers AI live test reuses PORTFOLIO_RAG_CLOUDFLARE_WORKERS_AI_TOKEN.

# --- Not used ---------------------------------------------------------------
# There is no database and no conversation state: every question is answered on
# its own, from the corpus. See docs/ROADMAP.md for what is deliberately not
# being built.
